generator client {
  provider      = "prisma-client-js"
  output        = "../../backend/node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String            @unique
  password         String?
  emailVerified    DateTime?
  image            String?
  bio              String?
  role             String            @default("user")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  ratings          BlogRating[]
  blogViews        BlogView[]
  blogs            Blog[]
  comments         Comment[]
  feedbackComments FeedbackComment[]
  feedbacks        Feedback[]
  likes            Like[]
  news             News[]
  newsRatings      NewsRating[]
  newsViews        NewsView[]
  sessions         Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]
  news        News[]   @relation("NewsCategory")

  @@map("categories")
}

model Blog {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String       @unique
  content          String
  excerpt          String?
  coverImage       String?
  published        Boolean      @default(false)
  views            Int          @default(0)
  authorId         String       @db.ObjectId
  categoryId       String       @db.ObjectId
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  canonicalUrl     String?
  ogImage          String?
  noIndex          Boolean      @default(false)
  titleAlignment   String       @default("left")
  ratings          BlogRating[]
  blogViews        BlogView[]
  author           User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         Category     @relation(fields: [categoryId], references: [id])
  comments         Comment[]
  feedbackMentions Feedback[]
  likes            Like[]
  tags             Tag[]        @relation("blogtotag", fields: [tagIds], references: [id])
  tagIds           String[]     @db.ObjectId

  @@map("blogs")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  authorId  String   @db.ObjectId
  blogId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  blogId    String   @db.ObjectId
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@map("likes")
}

model Tag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  blogs     Blog[]   @relation("blogtotag", fields: [blogIds], references: [id])
  blogIds   String[] @db.ObjectId

  @@map("tags")
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model Feedback {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  content         String
  authorName      String?
  authorEmail     String?
  userId          String?           @db.ObjectId
  mentionedBlogId String?           @db.ObjectId
  likes           Int               @default(0)
  dislikes        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  mentionedNewsId String?           @db.ObjectId
  comments        FeedbackComment[]
  likeActions     FeedbackLike[]
  mentionedBlog   Blog?             @relation(fields: [mentionedBlogId], references: [id])
  mentionedNews   News?             @relation("NewsFeedback", fields: [mentionedNewsId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model FeedbackComment {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  authorName  String?
  authorEmail String?
  userId      String?           @db.ObjectId
  feedbackId  String            @db.ObjectId
  parentId    String?           @db.ObjectId
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  feedback    Feedback          @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  parent      FeedbackComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     FeedbackComment[] @relation("CommentReplies")
  user        User?             @relation(fields: [userId], references: [id])

  @@map("feedback_comments")
}

model FeedbackLike {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  sessionId  String?
  feedbackId String   @db.ObjectId
  isLike     Boolean
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@unique([feedbackId, sessionId])
  @@map("feedback_likes")
}

model BlogRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  userId    String?  @db.ObjectId
  sessionId String?
  blogId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
  @@unique([blogId, sessionId])
  @@map("blog_ratings")
}

model BlogView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  sessionId String?
  blogId    String   @db.ObjectId
  duration  Int      @default(0)
  scrolled  Boolean  @default(false)
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("blog_views")
}

model News {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String       @unique
  content          String
  excerpt          String?
  coverImage       String?
  published        Boolean      @default(false)
  featured         Boolean      @default(false)
  views            Int          @default(0)
  authorId         String       @db.ObjectId
  categoryId       String       @db.ObjectId
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  metaTitle        String?
  metaDescription  String?
  keywords         String?
  canonicalUrl     String?
  ogImage          String?
  noIndex          Boolean      @default(false)
  titleAlignment   String       @default("left")
  feedbackMentions Feedback[]   @relation("NewsFeedback")
  author           User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         Category     @relation("NewsCategory", fields: [categoryId], references: [id])
  ratings          NewsRating[]
  newsViews        NewsView[]

  @@map("news")
}

model NewsRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  userId    String?  @db.ObjectId
  sessionId String?
  newsId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([newsId, userId])
  @@unique([newsId, sessionId])
  @@map("news_ratings")
}

model NewsView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  sessionId String?
  newsId    String   @db.ObjectId
  duration  Int      @default(0)
  scrolled  Boolean  @default(false)
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("news_views")
}

model SiteSettings {
  id                String   @id @default("default") @map("_id")
  breakingNewsTitle String?
  updatedAt         DateTime @updatedAt
  breakingNewsId    String?

  @@map("site_settings")
}
